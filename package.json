{
  "name": "message",
  "version": "0.1.0",
  "private": true,
  "description": "Personal agent that auto-translates documents uploaded to a messenger chat into your native language",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "message": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "cli": "tsx src/cli/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "fixtures": "tsx scripts/fixtures/generate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@vitest/coverage-v8": "^5.0.0",
    "docx": "^9.7.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "iso-639-3": "^3.0.1",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "zod": "^4.5.4"
  }
}
