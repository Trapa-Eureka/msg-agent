{
  "name": "msg-agent",
  "version": "0.1.2",
  "description": "Personal agent that auto-translates documents uploaded to a messenger chat into your native language",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "msg-agent": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "cli": "tsx src/cli/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "fixtures": "tsx scripts/fixtures/generate.ts",
    "prepublishOnly": "npm run check && npm run build && npm run check:tarball",
    "check:tarball": "sh scripts/check-tarball.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^5.0.0",
    "docx": "^9.7.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "commander": "^15.0.0",
    "franc": "^6.2.0",
    "grammy": "^1.46.0",
    "iso-639-3": "^3.0.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "prompts": "^2.4.2",
    "zod": "^4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trapa-Eureka/msg-agent.git"
  },
  "keywords": [
    "telegram",
    "translation",
    "document",
    "pdf",
    "docx",
    "claude",
    "openai",
    "agent"
  ]
}
